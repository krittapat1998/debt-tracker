  "patterns": [
    {
      "id": "generic-statement",
      "bankId": "*",
      "kind": "statement",
      "priority": 10,
      "trigger": "ยอดเรียกเก็บ|ยอดชำระเต็ม|ยอดที่ต้องชำระ|ใบแจ้งยอด|ขั้นต่ำ|statement|minimum",
      "amount": [
        "(?:ยอดเรียกเก็บ(?:เงิน)?|ยอดชำระเต็ม(?:จำนวน)?|ยอดที่ต้องชำระ(?:ทั้งหมด)?|ยอดรวม|statement balance|total(?: amount)? due|new balance)[^0-9]{0,30}?{MONEY}",
        "(?:จำนวน(?:เงิน)?|ยอด)\\s*(?:THB\\s*)?{AMOUNT}",
        "{AMOUNT}\\s*(?:บาท|บ\\.|THB)",
        "(?:THB|฿)\\s*{AMOUNT}"
      ],
      "minimum": [
        "(?:ขั้นต่ำ|min(?:imum)?(?: payment)?(?: due)?)[^0-9]{0,25}?{AMOUNT}"
      ],
      "dueDate": [
        "(?:ครบกำหนด(?:ชำระ)?|กำหนดชำระ|ชำระ(?:เงิน)?(?:ได้)?(?:ภายใน|ก่อน)(?:วันที่)?|ภายใน(?:วันที่)?|due(?: date)?(?: on)?|pay by)[^0-9]{0,15}?{DATE}"
      ],
      "date": [
        "(?:รอบ(?:บัญชี|บิล)?|statement date|ณ\\s*วันที่)\\s*(?:วันที่)?\\s*{DATE}"
      ],
      "card": [
        "(?:บัตร(?:เครดิต)?|card|ลงท้าย(?:ด้วย)?|ending)[^0-9]{0,20}?(\\d{4})(?![0-9,.])",
        "[xX*•]{2,}[\\s\\-]?(\\d{4})(?![0-9,.])",
        "(?<![A-Za-z])[xX*](\\d{4})(?![0-9,.])"
      ]
    },
    {
      "id": "generic-payment",
      "bankId": "*",
      "kind": "payment",
      "priority": 20,
      "trigger": "ได้รับ(?:การ)?ชำระ|รับชำระ|ชำระ[^.]{0,40}?(?:เรียบร้อย|สำเร็จ)|ขอบคุณ(?:ที่|สำหรับการ)ชำระ|payment (?:received|of|has been received)|received your payment|thank you for (?:your )?payment",
      "amount": [
        "(?:จำนวน(?:เงิน)?|ยอดเงิน|ยอดชำระ|amount|payment of)[^0-9]{0,15}?{AMOUNT}",
        "{AMOUNT}\\s*(?:บาท|บ\\.|THB)",
        "(?:THB|฿)\\s*{AMOUNT}",
        "ชำระ(?:เงิน)?[^0-9]{0,15}?{MONEY}"
      ],
      "date": [
        "(?:วันที่|เมื่อ|on)\\s*{DATE}"
      ],
      "card": [
        "(?:บัตร(?:เครดิต)?|card|ลงท้าย(?:ด้วย)?|ending)[^0-9]{0,20}?(\\d{4})(?![0-9,.])",
        "[xX*•]{2,}[\\s\\-]?(\\d{4})(?![0-9,.])",
        "(?<![A-Za-z])[xX*](\\d{4})(?![0-9,.])"
      ]
    },
    {
      "id": "generic-spending",
      "bankId": "*",
      "kind": "spending",
      "priority": 30,
      "trigger": "ใช้จ่าย|ใช้บัตร|รูดบัตร|ทำรายการ(?:ใช้จ่าย|ซื้อ|ชำระสินค้า)|ชำระสินค้า|spent|purchase|spending",
      "amount": [
        "(?:จำนวน(?:เงิน)?|ยอด(?:เงิน)?|ใช้จ่าย|spent|amount|purchase of)[^0-9]{0,15}?{MONEY}",
        "{AMOUNT}\\s*(?:บาท|บ\\.|THB)",
        "(?:THB|฿)\\s*{AMOUNT}"
      ],
      "date": [
        "(?:วันที่|เมื่อ|on)\\s*{DATE}",
        "{DATE}\\s+\\d{1,2}:\\d{2}"
      ],
      "card": [
        "(?:บัตร(?:เครดิต)?|card|ลงท้าย(?:ด้วย)?|ending)[^0-9]{0,20}?(\\d{4})(?![0-9,.])",
        "[xX*•]{2,}[\\s\\-]?(\\d{4})(?![0-9,.])",
        "(?<![A-Za-z])[xX*](\\d{4})(?![0-9,.])"
      ]
    }
  ]
}